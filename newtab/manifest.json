{
  "manifest_version": 3,
  "name": "Board",
  "version": "2.0",
  "description": "Your own world on every new tab: draggable cards, checklists, links, images, countdowns and reminders.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "favicon", "downloads"]
}
